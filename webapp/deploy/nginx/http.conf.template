# nginx chạy HTTP (mặc định). Là template: ảnh nginx thay ${BIẾN} bằng biến môi trường rồi ghi ra /etc/nginx/nginx.conf
# (NGINX_ENVSUBST_OUTPUT_DIR trong docker-compose.yml); biến của nginx như $host không bị đụng tới.
# Reverse proxy + cân bằng tải (một bản API, một bản web; thêm "server api2:8080;" vào upstream để chạy nhiều bản).
# /api/* đi thẳng tới Spring Boot, phần còn lại tới Next.js. Chỉ container này mở cổng ra ngoài.
# Bản HTTPS: https.conf.template (bật bằng docker-compose.https.yml).

worker_processes 1;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 30s;
    client_max_body_size 1m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Chống dò mật khẩu và gửi dồn thư đặt lại mật khẩu ở tầng proxy; backend còn LoginThrottle theo IP và theo email.
    limit_req_zone $binary_remote_addr zone=auth:1m rate=20r/m;

    # Hỏi lại DNS của Docker thay vì giữ IP lúc nginx khởi động: "docker compose up --build" tạo lại container api/web
    # với IP mới, trước đây nginx vẫn gửi tới IP cũ và trả 502 tới khi khởi động lại nginx (03/11/2026).
    # "resolve" trong upstream có ở nginx bản mở từ 1.27.3, cần "zone" và "resolver".
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream api {
        zone upstream_api 64k;
        server api:8080 resolve;
        keepalive 8;
    }
    upstream web {
        zone upstream_web 64k;
        server web:3000 resolve;
        keepalive 8;
    }

    server {
        listen 80;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # $http_host giữ cả cổng (localhost:8088) để Spring thấy đúng origin trình duyệt, không chặn CORS nhầm.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Ghi đè, không nối: client không giả được IP để lách giới hạn đăng nhập.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;

        location ~ ^/api/v1/auth/(login|register|password-reset) {
            limit_req zone=auth burst=10 nodelay;
            limit_req_status 429;
            proxy_pass http://api;
        }
        # API nội bộ (pipeline gửi gói dữ liệu) chỉ gọi trong mạng Docker; backend cũng denyAll.
        location /api/v1/internal/ {
            return 404;
        }
        location /api/ {
            proxy_pass http://api;
        }
        # Actuator chỉ để healthcheck trong mạng Docker, không lộ ra ngoài.
        location /actuator/ {
            return 404;
        }
        location / {
            proxy_pass http://web;
        }
    }
}
