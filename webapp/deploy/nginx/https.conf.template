# nginx chạy HTTPS (docker-compose.https.yml). Template: ${HTTPS_PORT}, ${HSTS_MAX_AGE} lấy từ biến môi trường.
# Chứng chỉ ở deploy/certs/server.crt + server.key: tự ký (deploy/tao-chung-chi-tu-ky.sh) khi chưa có tên miền,
# hoặc Let's Encrypt khi đã có tên miền (service certbot ghi đè cùng tên file).
# Cổng 80 chỉ phục vụ tệp xác minh của Let's Encrypt, còn lại chuyển hướng sang HTTPS.

worker_processes 1;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 30s;
    client_max_body_size 1m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    limit_req_zone $binary_remote_addr zone=auth:1m rate=20r/m;

    # Hỏi lại DNS của Docker: container api/web tạo lại thì đổi IP (xem http.conf.template).
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream api {
        zone upstream_api 64k;
        server api:8080 resolve;
        keepalive 8;
    }
    upstream web {
        zone upstream_web 64k;
        server web:3000 resolve;
        keepalive 8;
    }

    server {
        listen 80;
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }
        location / {
            return 301 https://$host:${HTTPS_PORT}$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;

        ssl_certificate /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:1m;
        ssl_session_timeout 1h;

        # HSTS: trình duyệt nhớ "chỉ vào bằng HTTPS". Mặc định 0 (tắt) vì với localhost / chứng chỉ tự ký, HSTS sẽ ép mọi
        # cổng của localhost (kể cả next dev :3000) sang HTTPS. Có tên miền + chứng chỉ thật thì đặt HSTS_MAX_AGE=31536000.
        add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;

        location ~ ^/api/v1/auth/(login|register|password-reset) {
            limit_req zone=auth burst=10 nodelay;
            limit_req_status 429;
            proxy_pass http://api;
        }
        location /api/v1/internal/ {
            return 404;
        }
        location /api/ {
            proxy_pass http://api;
        }
        location /actuator/ {
            return 404;
        }
        location / {
            proxy_pass http://web;
        }
    }
}
