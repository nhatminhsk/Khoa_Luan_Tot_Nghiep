# Sao chép thành .env rồi điền giá trị. File .env không được đưa vào git.

# Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
APP_JWT_SECRET=

# Tài khoản quản trị tạo lúc khởi động (bỏ trống thì không tạo).
APP_ADMIN_EMAIL=admin@bankadvisor.test
APP_ADMIN_PASSWORD=

# Bật trang quản trị CSDL H2 tại http://localhost:8080/h2-console (chỉ dùng khi phát triển).
APP_H2_CONSOLE=false

# Gửi thông báo qua email: OFF (tắt), LOG (in email ra log, để thử khi chưa có máy chủ thư), SMTP (gửi thật).
APP_MAIL_MODE=OFF
# Địa chỉ giao diện web, dùng để dựng link trong email.
APP_WEB_BASE_URL=http://localhost:3000
# Chỉ cần khi APP_MAIL_MODE=SMTP. Cổng 587 + STARTTLS (bắt buộc TLS). Với Gmail: bật xác minh 2 bước rồi
# tạo "Mật khẩu ứng dụng" để điền APP_SMTP_PASSWORD; APP_MAIL_FROM phải là địa chỉ của tài khoản đó.
APP_MAIL_FROM=BankAdvisor <no-reply@bankadvisor.test>
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
