# Biến cho docker compose (docker-compose.yml và docker-compose.db.yml). Sao chép thành webapp/.env rồi điền.
# File .env không được đưa vào git.

# Mật khẩu CSDL PostgreSQL (tài khoản bankadvisor). Tạo chuỗi ngẫu nhiên, ví dụ PowerShell:
#   [Convert]::ToBase64String((1..24 | ForEach-Object { Get-Random -Maximum 256 }))
APP_DB_PASSWORD=

# Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên (cùng cách tạo như trên với 48 byte).
APP_JWT_SECRET=

# Tài khoản quản trị tạo lúc khởi động lần đầu (bỏ trống thì không tạo).
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Cổng web trên máy chủ (nginx). Có HTTPS thì đặt APP_COOKIE_SECURE=true.
HTTP_PORT=8088
APP_COOKIE_SECURE=false
APP_WEB_BASE_URL=http://localhost:8088

# Email: OFF / LOG / SMTP (xem webapp/backend/.env.example).
APP_MAIL_MODE=OFF
APP_MAIL_FROM=BankAdvisor <no-reply@bankadvisor.test>
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=

# Chỉ docker-compose.db.yml: cổng PostgreSQL mở trên 127.0.0.1 cho backend chạy trên máy.
DB_PORT=5432

# HTTPS (docker-compose.https.yml). Chưa có tên miền: chạy deploy/tao-chung-chi-tu-ky.sh để có chứng chỉ tự ký.
HTTPS_PORT=8443
APP_WEB_BASE_URL_HTTPS=https://localhost:8443
# Chỉ bật khi có tên miền + chứng chỉ thật (31536000 = 1 năm); với localhost sẽ ép mọi cổng localhost sang HTTPS.
HSTS_MAX_AGE=0

# Chứng chỉ thật từ Let's Encrypt, tự gia hạn. Cần tên miền đã trỏ về máy này và cổng 80, 443 mở ra Internet.
# Đặt COMPOSE_PROFILES=letsencrypt, HTTP_PORT=80, HTTPS_PORT=443, APP_WEB_BASE_URL_HTTPS=https://ten-mien.
# Điền LE_EMAIL nghĩa là đồng ý Subscriber Agreement của Let's Encrypt. Nhiều tên miền: a.vn,www.a.vn
COMPOSE_PROFILES=
LE_DOMAINS=
LE_EMAIL=

# Giờ sao lưu CSDL hằng ngày (container backup), giờ Việt Nam.
BACKUP_AT=02:00
